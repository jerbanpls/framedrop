# --- Picture frame (sk.mimac.slideshow web server) ---
FRAME_URL=http://192.168.1.50:8080
FRAME_USER=admin
FRAME_PASS=changeme
FRAME_WIDTH=1920
FRAME_HEIGHT=1200

# --- Local mirror (inside the container; ./data on the host) ---
STORAGE_PATH=/data/photos
# THUMBS_PATH=/data/thumbs
# STATE_FILE=/data/state.json

# Host port for the web UI
FRAMEDROP_PORT=8000

# --- Optional: mirror an Immich album onto the frame ---
# All three must be set to enable. Photos removed from the album are removed from the frame.
IMMICH_URL=
IMMICH_API_KEY=
IMMICH_ALBUM_ID=
SYNC_INTERVAL_MINUTES=60
# blur | crop
IMMICH_RESIZE_MODE=blur
